# Copy to .env for local runs. In production these are set as platform secrets,
# never baked into the image.

# --- Required ---------------------------------------------------------------

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# --- Who writes it -----------------------------------------------------------

# Every model call goes through the relay: written to a file under RELAY_DIR,
# answered, and the answer written beside it, with a ledger. RELAY_ANSWER says
# who answers:
#   claude:  Claude Code, run headless once per call (the default, and the
#            service as deployed). Uses your Claude subscription, not API credit.
#   session: nobody -- the run waits for reply files written by hand, usually
#            by a Claude Code session with a subagent per request. docs/RUNBOOK.md.
RELAY_ANSWER=claude

# How Claude Code logs in. On a desktop where you have run /login, leave this
# empty. On a server, run `claude setup-token` on your own machine and paste the
# token here (or set it as a platform secret). One year, your subscription only.
CLAUDE_CODE_OAUTH_TOKEN=

# The Claude Code executable, if it is not "claude" on the PATH.
CLAUDE_BIN=claude

# Which model answers each stage, by alias or full name. Every stage defaults
# to Opus 5.5 (claude-opus-5-5). Leave empty to keep it.
MODEL_TRIAGE=
MODEL_REVIEW=
MODEL_BRIEF=
MODEL_NAMES=
MODEL_THEMES=
MODEL_SCOUT=
MODEL_RESEARCH=
MODEL_VERDICTS=
MODEL_ANALYSIS=
MODEL_INDUSTRY=
MODEL_TERMS=
MODEL_RELEASE=

# Where each run's requests, replies and ledger are kept. Defaults to
# DATA_DIR/relay. The last forty runs are kept.
RELAY_DIR=

# How many sorting batches run at once (each is its own Claude Code process),
# and how long one call may take before it is treated as hung. The timeout
# defaults to 20m, or 3h when RELAY_ANSWER=session.
RELAY_CONCURRENCY=2
CALL_TIMEOUT=

# --- Delivery ---------------------------------------------------------------

# Delete the previous brief before sending a new one. Off by default: the
# deletion is irreversible, Telegram only permits it for 48 hours, and you may
# want yesterday's brief. Useful while iterating, when repeated runs bury the chat.
REPLACE_PREVIOUS=false

# Send long messages -- the brief, the closer look, /analyse, /industry -- as
# a short summary with a button to the whole thing as a web page, which the
# service serves itself at PAGES_URL/r/<random id>. Leave empty to send
# everything in full, as messages. PAGES_ADDR is where it listens (:8080).
PAGES_URL=
PAGES_ADDR=

# How much of the source list the brief carries.
#   short: up to 8 links per category (the default)
#   full:  every article behind each category, plus the general news the
#          overview drew on -- for checking the brief against its sources.
#          Adds several messages of links.
#   off:   no source list at all, just the analysis and the footer.
SOURCE_LINKS=short

# Your own chat: the brief, the closer look and failure reports go here, and it
# alone has every command. Leave empty and the bot records the first chat to
# send /start; it is then persisted to prefs.yaml. (TELEGRAM_CHAT_ID, its
# earlier name, still works.)
TELEGRAM_MASTER_CHAT_ID=

# A channel for other people to read the brief in, e.g. -1001234567890. The
# bot must be an admin there with the right to post. The daily brief goes to
# the channel as well as to you; /share posts the latest brief or analysis on
# request. Readers can only read: the bot takes commands from your chat alone.
# Empty means no channel. docs/RUNBOOK.md, "A channel for other readers".
TELEGRAM_CHANNEL_ID=

# Other chats of your own that may send commands, comma-separated ids, such
# as your own bots. Each reply goes back to the chat that asked; the daily
# brief, the closer look and failure reports still come to you alone.
#   COMMAND: /analyse, /industry, /help, /stats, /usage, /scorecard, /schedule
#   CONTROL: all of those, and /now, /watchlist and /sources too. A /now
#            from one is delivered there, not to you.
# /start, /clear and /share stay yours. Every command runs on your Claude
# plan. docs/RUNBOOK.md, "Other chats that may send commands".
TELEGRAM_COMMAND_CHATS=
TELEGRAM_CONTROL_CHATS=

# --- Schedule ---------------------------------------------------------------

# The report fires at REPORT_AT in SCHEDULE_TZ. Scheduling in US Eastern keeps
# delivery pinned to the same point in the trading day all year (07:30 ET is
# two hours before the open, and the closer look arrives about half an hour
# after the brief). In Singapore that arrives at 20:30 while New York is on EST and
# 19:30 while it is on EDT -- the shift is the US DST transition, since
# Singapore has none of its own.
SCHEDULE_TZ=America/New_York
REPORT_AT=07:30

# Timezone used to render timestamps inside the report.
DISPLAY_TZ=Asia/Singapore

# --- Sources -----------------------------------------------------------------

# How the fetcher identifies itself to publishers. SEC EDGAR requires the exact
# form "Name email@domain" and returns 403 for anything else -- including a
# browser string -- so set a real contact address here. Every other default
# feed works without this.
USER_AGENT=Market Watch you@example.com

# Key from tavily.com. With it, each brief also searches for the news instead
# of only polling feeds: three general searches and one per watchlist, about
# fifteen in all, restricted to a list of reputable outlets (internal/search/
# outlets.go), plus one for each watchlist share that moved at least three
# percentage points further than the S&P 500, at most five. This reaches publications with no usable feed -- Reuters,
# Bloomberg, the Wall Street Journal, Nikkei Asia -- and a search does not
# break the way a feed address does. The feeds still run beside it: they carry
# the government releases and company announcements themselves, which a
# search only finds second-hand. /stats compares the two.
#
# Each search costs one credit. The free plan is 1,000 a month; weekday briefs
# use about 330, up to 440 on days with movers. Without a key the brief comes
# from the feeds alone.
# `market-watch --check` proves the key for free. Tavily's count of credits used
# runs late; /stats shows what each brief spent.
TAVILY_API_KEY=

# Free key from massive.com (formerly Polygon.io). It reads every US listing's
# day in one request, and the service keeps two years of them in data/market:
# where the closer look finds its companies, the week's themes from the market's
# leaders and industries, and the day's reactions from shares that moved far
# beyond their usual. The free plan allows five requests a minute and reaches
# two years back, so the first fill takes about two hours, in the background,
# and a day after it one request. Without it there is no closer look.
MASSIVE_API_KEY=

# What analysts expect of a company -- its earnings forecasts and which way they
# moved in the last four weeks, price targets, how it did against forecasts --
# and what its insiders, short sellers and funds have done, read from the data
# behind Nasdaq's website for the closer look and /analyse. No key: it is the
# site's own unofficial endpoint, so it can change or refuse without notice, and
# false stops asking.
CONSENSUS=true

# --- Optional ---------------------------------------------------------------

# Directory for the SQLite dedupe database and prefs.yaml.
# Set to /data in production, where the volume is mounted.
DATA_DIR=./data

# Ceiling on articles sent to the brief. An ordinary day fits under it; it only
# bites on heavy days, when triage ratings decide what stays.
MAX_ARTICLES=600

# A model reads every article first: it rates market relevance 1-5, removes
# unmatched articles rated 1, and places articles in the sectors their
# substance bears on, judged against the descriptions in config/sectors.yaml.
# Set false to rank on matches by company name and ticker, and source weight,
# alone.
TRIAGE=true

# Then a second look at where everything that will reach the brief was placed:
# the review moves the ones that belong in another section -- a broker's note on
# an oil company out of Financials, say -- and may search the web to learn what
# an unfamiliar company does. It needs TRIAGE. /stats shows what it moved.
REVIEW=true

# /analyse may look up anything the company reports to the SEC, beyond the
# figures it is given, and calculate exactly: three tools the service serves
# to Claude Code for the analysis call alone. Set false to work from the
# figures and the web only.
ANALYSIS_TOOLS=true

# Free key from fred.stlouisfed.org/docs/api/api_key.html. It gives the brief
# measured levels -- yields, fed funds, the VIX, and inflation from the consumer
# price index. Without it the brief omits that block; everything else is
# unaffected.
FRED_API_KEY=
HTTP_TIMEOUT=20s
LOG_LEVEL=info

# Free key from finnhub.io. It prices every watchlist share at the start of a
# brief -- about two minutes at the free tier's pace -- which gives each section
# its line of biggest moves and picks the shares whose moves get a search of
# their own, and it carries company news into the analysis. Without it all of
# that is omitted and nothing else changes. Listings
# outside the US are priced from daily chart history instead, which needs no
# key at all -- the keyed vendors' free tiers are US-only whatever their
# marketing says, Twelve Data's included.
FINNHUB_API_KEY=

# Skip the Saturday and Sunday briefs. They would cover days the US market was
# shut, carrying news that Friday's brief already reported.
SKIP_WEEKENDS=true

# Add the "new names in the news" section: companies the day was about that no
# watchlist tracks. Every ticker is checked against the exchange before it is
# shown.
DISCOVER=true

# About half an hour after the daily brief, "worth a closer look", each company
# with a buy, hold or sell verdict recorded for /scorecard. On Mondays, up to ten
# found from the market's numbers, under the themes the market has been paying
# for and the industries growing before their shares have followed; every day,
# up to three shares that moved far beyond their usual on the news. Companies
# you follow are left to the brief. It goes to your chat and, under a note that
# a model wrote it and it is not advice, to the channel. It starts twenty
# minutes after the brief; after /now it follows at once, to you alone, with
# the day's reactions only. false turns it off.
IDEAS=true
